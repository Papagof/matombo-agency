<%
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Service",
  serviceType: "Digital marketing",
  provider: { "@type": "Organization", name: "Matombo Agency" },
  areaServed: "Lagos, Nigeria",
  audience: { "@type": "BusinessAudience", name: "Hotels, restaurants and real estate" },
  hasOfferCatalog: {
    "@type": "OfferCatalog",
    name: "Marketing services",
    itemListElement: services.map(function (s) { return { "@type": "Offer", name: s.name }; }),
  },
};
%>
<!DOCTYPE html>
<html lang="en">
<head>
<%- include('partials/head', {
  title: "Services — SEO, paid ads & content for Lagos hotels, restaurants & real estate",
  description: "Matombo Agency services: local SEO, paid acquisition, social, content and high-converting landing pages for Hotels Lagos, AirBnB Lagos, Restaurant and lounge Lagos and real estate Lagos.",
  keywords: "SEO Lagos, paid ads Lagos, Hotels Lagos, AirBnB Lagos, Restaurant and lounge Lagos, real estate Lagos marketing",
  jsonLd: jsonLd,
}) %>
</head>
<body>

<%- include('partials/nav', { active: 'services' }) %>

<!-- HERO -->
<section class="section--dark">
  <div class="container section--hero">
    <span class="hero-eyebrow">What we do</span>
    <h1 class="hero-title" style="color:var(--stone-50);max-width:16ch">Everything you need to grow. Nothing you don't.</h1>
    <p class="hero-subtitle" style="color:var(--stone-300)">A focused set of services, built for hospitality and property. Pick the engine you need — or let us run the whole thing.</p>
  </div>
</section>

<!-- SERVICES GRID -->
<section class="container section">
  <div class="cards-grid">
    <% services.forEach(function (service) { %>
    <div class="card">
      <span class="icon-tile icon-tile--primary" aria-hidden="true"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><%- service.iconPath %></svg></span>
      <h3 style="font-size:21px;margin:0 0 8px"><%= service.name %></h3>
      <p style="margin:0;font-size:15px;line-height:1.55;color:var(--text-secondary)"><%= service.description %></p>
    </div>
    <% }); %>
  </div>
</section>

<!-- PROCESS TIMELINE -->
<section class="section--surface">
  <div class="container section">
    <div class="section-head">
      <span class="section-eyebrow">The process</span>
      <h2 class="section-title">From first call to compounding growth.</h2>
    </div>
    <ol class="process-grid">
      <li><div class="process-grid-head"><span class="process-grid-num">1</span><span class="process-grid-line" aria-hidden="true"></span></div><h3 class="process-title">Discovery call</h3><p class="process-body">A free 30-minute call to understand your venue, goals and margins.</p></li>
      <li><div class="process-grid-head"><span class="process-grid-num">2</span><span class="process-grid-line" aria-hidden="true"></span></div><h3 class="process-title">Strategy & plan</h3><p class="process-body">A keyword-led growth plan with clear targets and a transparent budget.</p></li>
      <li><div class="process-grid-head"><span class="process-grid-num">3</span><span class="process-grid-line" aria-hidden="true"></span></div><h3 class="process-title">Build & launch</h3><p class="process-body">Campaigns, content and pages go live — usually within two weeks.</p></li>
      <li><div class="process-grid-head"><span class="process-grid-num">4</span><span class="process-grid-line" aria-hidden="true"></span></div><h3 class="process-title">Optimise</h3><p class="process-body">Weekly tuning toward the numbers that matter, killing what doesn't work.</p></li>
      <li><div class="process-grid-head"><span class="process-grid-num process-grid-num--last">5</span></div><h3 class="process-title">Scale</h3><p class="process-body">Reinvest what works into more bookings, more covers, more closings.</p></li>
    </ol>
  </div>
</section>

<!-- COMPARISON TABLE -->
<section class="container section">
  <div class="section-head">
    <span class="section-eyebrow">Why Matombo</span>
    <h2 class="section-title">The honest comparison.</h2>
  </div>
  <div class="table-wrap">
    <table class="compare-table">
      <caption>How Matombo compares to a typical agency and an in-house hire</caption>
      <thead>
        <tr>
          <th scope="col">What matters</th>
          <th scope="col" class="is-featured">Matombo</th>
          <th scope="col">Typical agency</th>
          <th scope="col">In-house hire</th>
        </tr>
      </thead>
      <tbody>
        <tr><th scope="row">Knows the Lagos market</th><td class="is-featured">Deeply</td><td>Sometimes</td><td>Maybe</td></tr>
        <tr><th scope="row">Hospitality & property focus</th><td class="is-featured">Exclusive</td><td>Generalist</td><td>One brand</td></tr>
        <tr><th scope="row">Reports in revenue</th><td class="is-featured">Always</td><td>Vanity metrics</td><td>Varies</td></tr>
        <tr><th scope="row">Full skill set</th><td class="is-featured">SEO, ads, content</td><td>Often siloed</td><td>Limited</td></tr>
        <tr><th scope="row">Time to results</th><td class="is-featured">~2 weeks</td><td>1–2 months</td><td>3+ months</td></tr>
      </tbody>
    </table>
  </div>
</section>

<!-- PRICING TIERS -->
<section class="section--dark">
  <div class="container section">
    <div class="section-head">
      <span class="hero-eyebrow">Simple plans</span>
      <h2 class="section-title" style="color:var(--stone-50)">Pricing that scales with you.</h2>
    </div>
    <div class="cards-grid" style="align-items:stretch">
      <% tiers.forEach(function (tier) { %>
      <% if (tier.highlighted) { %>
      <div class="pricing-card pricing-card--highlighted">
        <span class="badge pricing-badge" style="background:var(--primary);color:#fff">Most popular</span>
        <h3 class="pricing-name"><%= tier.name %></h3>
        <p class="pricing-tagline"><%= tier.tagline %></p>
        <div class="pricing-price"><span class="pricing-price-value"><%= tier.priceLabel %></span><% if (tier.priceSuffix) { %><span class="pricing-price-suffix"><%= tier.priceSuffix %></span><% } %></div>
        <ul class="pricing-features">
          <% tier.features.forEach(function (feature) { %>
          <li><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"></path></svg><%= feature %></li>
          <% }); %>
        </ul>
        <a href="/contact" class="btn btn-primary pricing-cta"><%= tier.ctaLabel %></a>
      </div>
      <% } else { %>
      <div class="pricing-card pricing-card--plain">
        <h3 class="pricing-name"><%= tier.name %></h3>
        <p class="pricing-tagline"><%= tier.tagline %></p>
        <div class="pricing-price"><span class="pricing-price-value"><%= tier.priceLabel %></span><% if (tier.priceSuffix) { %><span class="pricing-price-suffix"><%= tier.priceSuffix %></span><% } %></div>
        <ul class="pricing-features">
          <% tier.features.forEach(function (feature) { %>
          <li><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"></path></svg><%= feature %></li>
          <% }); %>
        </ul>
        <a href="/contact" class="btn btn-outline-dark pricing-cta"><%= tier.ctaLabel %></a>
      </div>
      <% } %>
      <% }); %>
    </div>
  </div>
</section>

<!-- FAQ -->
<section class="container section" style="max-width:880px">
  <div style="margin-bottom:36px">
    <span class="section-eyebrow">Questions</span>
    <h2 class="section-title">Frequently asked.</h2>
  </div>
  <div class="accordion">
    <details class="accordion-item">
      <summary>Which industries do you work with?<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9l6 6 6-6"></path></svg></summary>
      <div class="accordion-body">We focus exclusively on hospitality and property in Lagos — hotels and short-stays, restaurants and lounges, and real estate. That focus is exactly why we get results faster.</div>
    </details>
    <details class="accordion-item">
      <summary>How quickly will I see results?<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9l6 6 6-6"></path></svg></summary>
      <div class="accordion-body">Paid campaigns can drive bookings within the first two weeks. SEO compounds over three to six months — we run both so you get quick wins and lasting growth.</div>
    </details>
    <details class="accordion-item">
      <summary>Is there a long contract?<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9l6 6 6-6"></path></svg></summary>
      <div class="accordion-body">No long lock-ins. We work on a rolling monthly basis — we'd rather earn your business every month than trap you in a contract.</div>
    </details>
    <details class="accordion-item">
      <summary>Do you handle ad budget separately?<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9l6 6 6-6"></path></svg></summary>
      <div class="accordion-body">Yes. Our fees cover strategy and management; your ad spend is separate and fully transparent — you always see exactly where it goes.</div>
    </details>
  </div>
</section>

<!-- CTA BAND -->
<section class="section--surface">
  <div class="container section" style="display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:32px">
    <div style="flex:1 1 420px;min-width:0">
      <h2 class="section-title" style="margin-bottom:14px">Not sure which plan fits?</h2>
      <p style="font-size:18px;line-height:1.55;color:var(--text-secondary);margin:0;max-width:52ch">Book a free strategy call. We'll recommend the right starting point — no pressure.</p>
    </div>
    <a href="/contact" class="btn btn-primary" style="height:54px;font-size:18px">Book a free strategy call <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 5l7 7-7 7"></path></svg></a>
  </div>
</section>

<%- include('partials/footer') %>

</body>
</html>
