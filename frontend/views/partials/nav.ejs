<%
const navLinks = [
  { href: "/", key: "home", label: "Home" },
  { href: "/about", key: "about", label: "About" },
  { href: "/services", key: "services", label: "Services" },
  { href: "/portfolio", key: "portfolio", label: "Portfolio" },
  { href: "/blog", key: "blog", label: "Blog" },
  { href: "/contact", key: "contact", label: "Contact" },
];
%>
<header class="site-header">
  <nav class="site-nav" aria-label="Primary">
    <a href="/" class="nav-brand" aria-label="Matombo Agency home">
      <span class="nav-logo" aria-hidden="true"><img src="https://picsum.photos/seed/matomborock/120/120" alt="Matombo Agency rock logo"></span>
      <span class="nav-wordmark">
        <span class="nav-wordmark-main">Matombo</span>
        <span class="nav-wordmark-sub">Agency &middot; Lagos</span>
      </span>
    </a>
    <div class="nav-links">
      <% navLinks.forEach(function (link) { %>
      <a href="<%= link.href %>" class="nav-link<%= link.key === active ? ' is-active' : '' %>"<% if (link.key === active) { %> aria-current="page"<% } %>><%= link.label %></a>
      <% }); %>
      <a href="/contact" class="btn btn-primary btn-sm">Book a free call</a>
    </div>
  </nav>
</header>
