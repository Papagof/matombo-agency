<%
const featuredCase = caseStudies.find(function (c) { return c.featured; });
const gridCases = caseStudies.filter(function (c) { return !c.featured; });
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  name: "Matombo Agency Portfolio",
  about: "Digital marketing case studies for hotels, restaurants and real estate in Lagos",
  publisher: { "@type": "Organization", name: "Matombo Agency" },
};
%>
<!DOCTYPE html>
<html>
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<script src="./support.js"></script>
</head>
<body>
<x-dc>
<%- include('partials/head', {
  title: "Portfolio — Matombo Agency case studies for Lagos hospitality & property",
  description: "Real results for Lagos brands: hotels filling rooms, restaurants and lounges selling out, and real estate teams closing faster. See Matombo Agency case studies.",
  keywords: "marketing case studies Lagos, Hotels Lagos, AirBnB Lagos, Restaurant and lounge Lagos, real estate Lagos",
  jsonLd: jsonLd,
}) %>

<div style="font-family:var(--font-body);color:var(--text-primary);background:var(--bg-page);overflow-x:hidden;min-height:100vh">

  <%- include('partials/nav', { active: 'portfolio' }) %>

  <!-- HERO -->
  <section style="max-width:1200px;margin:0 auto;padding:clamp(48px,7vw,88px) 24px clamp(32px,5vw,48px)">
    <span style="display:inline-block;font-size:12px;font-weight:600;letter-spacing:0.16em;text-transform:uppercase;color:var(--primary);margin-bottom:18px">Selected work</span>
    <h1 style="font-family:var(--font-display);font-weight:700;font-size:clamp(38px,6.5vw,80px);line-height:1.03;letter-spacing:-0.02em;margin:0 0 20px;max-width:16ch">Proof, not promises.</h1>
    <p style="font-size:clamp(17px,1.6vw,20px);line-height:1.55;color:var(--text-secondary);max-width:60ch;margin:0">A look at what focused, revenue-first marketing does for Lagos hotels, restaurants and property brands.</p>
  </section>

  <!-- FEATURED CASE -->
  <% if (featuredCase) { %>
  <section style="max-width:1200px;margin:0 auto;padding:0 24px clamp(40px,5vw,56px)">
    <article style="border:1px solid var(--border);border-radius:12px;overflow:hidden;display:flex;flex-wrap:wrap;background:var(--surface)">
      <div style="flex:1 1 380px;min-width:0"><img src="https://picsum.photos/seed/<%= featuredCase.imageSeed %>/1000/800" alt="<%= featuredCase.title %>" loading="lazy" width="1000" height="800" style="display:block;width:100%;height:100%;min-height:300px;object-fit:cover;filter:grayscale(1) contrast(1.04) sepia(0.42) saturate(1.5) hue-rotate(-12deg)"></div>
      <div style="flex:1 1 360px;min-width:0;padding:clamp(28px,4vw,48px);display:flex;flex-direction:column;justify-content:center">
        <div style="display:flex;gap:8px;margin-bottom:18px">
          <span style="display:inline-flex;align-items:center;padding:3px 10px;border-radius:9999px;background:<%= featuredCase.badge.bg %>;color:<%= featuredCase.badge.color %>;font-size:12px;font-weight:600"><%= featuredCase.badge.label %></span>
          <% featuredCase.tags.slice(1).forEach(function (tag) { %>
          <span style="display:inline-flex;align-items:center;padding:3px 10px;border-radius:9999px;background:var(--stone-200);color:var(--stone-700);font-size:12px;font-weight:600"><%= tag %></span>
          <% }); %>
        </div>
        <h2 style="font-family:var(--font-display);font-weight:700;font-size:clamp(26px,3.4vw,38px);line-height:1.08;letter-spacing:-0.02em;margin:0 0 14px"><%= featuredCase.title %></h2>
        <p style="font-size:16px;line-height:1.6;color:var(--text-secondary);margin:0 0 24px;max-width:52ch"><%= featuredCase.summary %></p>
        <div style="display:flex;flex-wrap:wrap;gap:32px">
          <% featuredCase.metrics.forEach(function (metric) { %>
          <div><div style="font-family:var(--font-display);font-weight:700;font-size:36px;line-height:1;color:var(--primary)"><%= metric.value %></div><p style="margin:6px 0 0;font-size:13px;color:var(--text-muted)"><%= metric.label %></p></div>
          <% }); %>
        </div>
      </div>
    </article>
  </section>
  <% } %>

  <!-- CASE GRID -->
  <section style="max-width:1200px;margin:0 auto;padding:0 24px clamp(56px,8vw,88px)">
    <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(300px,1fr));gap:24px">
      <% gridCases.forEach(function (caseStudy) { %>
      <x-import component-from-global-scope="EmberStudioDesignSystem_64dbe4.Card" hint-size="100%,380px" style="height:100%;padding:0;overflow:hidden">
        <article style="display:flex;flex-direction:column;height:100%">
          <img src="https://picsum.photos/seed/<%= caseStudy.imageSeed %>/800/520" alt="<%= caseStudy.title %>" loading="lazy" width="800" height="520" style="display:block;width:100%;height:200px;object-fit:cover;filter:grayscale(1) contrast(1.04) sepia(0.42) saturate(1.5) hue-rotate(-12deg)">
          <div style="padding:20px;display:flex;flex-direction:column;flex:1">
            <span style="display:inline-flex;align-self:flex-start;align-items:center;padding:3px 10px;border-radius:9999px;background:<%= caseStudy.badge.bg %>;color:<%= caseStudy.badge.color %>;font-size:12px;font-weight:600;margin-bottom:12px"><%= caseStudy.badge.label %></span>
            <h3 style="font-family:var(--font-display);font-weight:700;font-size:20px;line-height:1.15;margin:0 0 8px"><%= caseStudy.title %></h3>
            <p style="font-size:14px;line-height:1.55;color:var(--text-secondary);margin:0 0 16px"><%= caseStudy.summary %></p>
            <div style="margin-top:auto;display:flex;gap:24px;border-top:1px solid var(--border);padding-top:16px">
              <% caseStudy.metrics.forEach(function (metric) { %>
              <div><div style="font-family:var(--font-display);font-weight:700;font-size:24px;color:var(--primary);line-height:1"><%= metric.value %></div><p style="margin:4px 0 0;font-size:12px;color:var(--text-muted)"><%= metric.label %></p></div>
              <% }); %>
            </div>
          </div>
        </article>
      </x-import>
      <% }); %>
    </div>
  </section>

  <!-- CTA BAND -->
  <section style="background:var(--stone-900);color:var(--stone-50)">
    <div style="max-width:1200px;margin:0 auto;padding:clamp(56px,8vw,88px) 24px;display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:32px">
      <div style="flex:1 1 420px;min-width:0">
        <h2 style="font-family:var(--font-display);font-weight:700;font-size:clamp(28px,4.5vw,48px);line-height:1.06;letter-spacing:-0.02em;margin:0 0 14px;color:var(--stone-50)">Your brand could be next.</h2>
        <p style="font-size:18px;line-height:1.55;color:var(--stone-300);margin:0;max-width:52ch">Book a free strategy call and we'll show you exactly how we'd grow your numbers.</p>
      </div>
      <a href="contact.dc.html" style="display:inline-flex;align-items:center;gap:10px;height:54px;padding:0 30px;border-radius:8px;background:var(--primary);color:#fff;font-weight:600;font-size:18px;text-decoration:none;border:1px solid var(--primary);transition:background 150ms ease,box-shadow 150ms ease" style-hover="background:var(--primary-hover);box-shadow:var(--shadow-button-glow)" style-focus="outline:2px solid #fff;outline-offset:3px">Book a free strategy call <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 5l7 7-7 7"></path></svg></a>
    </div>
  </section>

  <%- include('partials/footer') %>

</div>
</x-dc>
</body>
</html>
