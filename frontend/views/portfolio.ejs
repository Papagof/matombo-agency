<%
const featuredCase = caseStudies.find(function (c) { return c.featured; });
const gridCases = caseStudies.filter(function (c) { return !c.featured; });
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  name: "Matombo Agency Portfolio",
  about: "Digital marketing case studies for hotels, restaurants and real estate in Lagos",
  publisher: { "@type": "Organization", name: "Matombo Agency" },
};
%>
<!DOCTYPE html>
<html lang="en">
<head>
<%- include('partials/head', {
  title: "Portfolio — Matombo Agency case studies for Lagos hospitality & property",
  description: "Real results for Lagos brands: hotels filling rooms, restaurants and lounges selling out, and real estate teams closing faster. See Matombo Agency case studies.",
  keywords: "marketing case studies Lagos, Hotels Lagos, AirBnB Lagos, Restaurant and lounge Lagos, real estate Lagos",
  jsonLd: jsonLd,
}) %>
</head>
<body>

<%- include('partials/nav', { active: 'portfolio' }) %>

<!-- HERO -->
<section class="container section--hero">
  <span class="hero-eyebrow">Selected work</span>
  <h1 class="hero-title" style="max-width:16ch">Proof, not promises.</h1>
  <p class="hero-subtitle">A look at what focused, revenue-first marketing does for Lagos hotels, restaurants and property brands.</p>
</section>

<!-- FEATURED CASE -->
<% if (featuredCase) { %>
<section class="container" style="padding:0 0 clamp(40px,5vw,56px)">
  <article class="card card--flush" style="flex-direction:row;flex-wrap:wrap">
    <div style="flex:1 1 380px;min-width:0"><img src="https://picsum.photos/seed/<%= featuredCase.imageSeed %>/1000/800" alt="<%= featuredCase.title %>" loading="lazy" width="1000" height="800" style="height:100%;min-height:300px;object-fit:cover;filter:grayscale(1) contrast(1.04) sepia(0.42) saturate(1.5) hue-rotate(-12deg)"></div>
    <div style="flex:1 1 360px;min-width:0;padding:clamp(28px,4vw,48px);display:flex;flex-direction:column;justify-content:center">
      <div style="display:flex;gap:8px;margin-bottom:18px">
        <span class="badge" style="background:<%= featuredCase.badge.bg %>;color:<%= featuredCase.badge.color %>"><%= featuredCase.badge.label %></span>
        <% featuredCase.tags.slice(1).forEach(function (tag) { %>
        <span class="badge badge--neutral"><%= tag %></span>
        <% }); %>
      </div>
      <h2 style="font-size:clamp(26px,3.4vw,38px);line-height:1.08;margin:0 0 14px"><%= featuredCase.title %></h2>
      <p style="font-size:16px;line-height:1.6;color:var(--text-secondary);margin:0 0 24px;max-width:52ch"><%= featuredCase.summary %></p>
      <div style="display:flex;flex-wrap:wrap;gap:32px">
        <% featuredCase.metrics.forEach(function (metric) { %>
        <div><div style="font-family:var(--font-display);font-weight:700;font-size:36px;line-height:1;color:var(--primary)"><%= metric.value %></div><p style="margin:6px 0 0;font-size:13px;color:var(--text-muted)"><%= metric.label %></p></div>
        <% }); %>
      </div>
    </div>
  </article>
</section>
<% } %>

<!-- CASE GRID -->
<section class="container" style="padding:0 0 clamp(56px,8vw,88px)">
  <div class="cards-grid cards-grid--wide">
    <% gridCases.forEach(function (caseStudy) { %>
    <article class="card card--flush">
      <img class="card-image" src="https://picsum.photos/seed/<%= caseStudy.imageSeed %>/800/520" alt="<%= caseStudy.title %>" loading="lazy" width="800" height="520">
      <div class="card-body">
        <span class="badge" style="align-self:flex-start;background:<%= caseStudy.badge.bg %>;color:<%= caseStudy.badge.color %>;margin-bottom:12px"><%= caseStudy.badge.label %></span>
        <h3 style="font-size:20px;line-height:1.15;margin:0 0 8px"><%= caseStudy.title %></h3>
        <p style="font-size:14px;line-height:1.55;color:var(--text-secondary);margin:0 0 16px"><%= caseStudy.summary %></p>
        <div style="margin-top:auto;display:flex;gap:24px;border-top:1px solid var(--border);padding-top:16px">
          <% caseStudy.metrics.forEach(function (metric) { %>
          <div><div style="font-family:var(--font-display);font-weight:700;font-size:24px;color:var(--primary);line-height:1"><%= metric.value %></div><p style="margin:4px 0 0;font-size:12px;color:var(--text-muted)"><%= metric.label %></p></div>
          <% }); %>
        </div>
      </div>
    </article>
    <% }); %>
  </div>
</section>

<!-- CTA BAND -->
<section class="section--dark">
  <div class="container section" style="display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:32px">
    <div style="flex:1 1 420px;min-width:0">
      <h2 class="section-title" style="margin-bottom:14px;color:var(--stone-50)">Your brand could be next.</h2>
      <p style="font-size:18px;line-height:1.55;color:var(--stone-300);margin:0;max-width:52ch">Book a free strategy call and we'll show you exactly how we'd grow your numbers.</p>
    </div>
    <a href="/contact" class="btn btn-primary" style="height:54px;font-size:18px">Book a free strategy call <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 5l7 7-7 7"></path></svg></a>
  </div>
</section>

<%- include('partials/footer') %>

</body>
</html>
