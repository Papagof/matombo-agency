<%
const featuredPost = posts.find(function (p) { return p.featured; });
const gridPosts = posts.filter(function (p) { return !p.featured; });
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Blog",
  name: "Matombo Agency Blog",
  publisher: { "@type": "Organization", name: "Matombo Agency" },
  blogPost: posts.map(function (p) {
    return {
      "@type": "BlogPosting",
      headline: p.title,
      datePublished: p.publishedAt.toISOString().slice(0, 10),
      author: { "@type": "Person", name: p.authorName },
    };
  }),
};
%>
<!DOCTYPE html>
<html>
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<script src="./support.js"></script>
</head>
<body>
<x-dc>
<%- include('partials/head', {
  title: "Blog — Lagos marketing insights for hotels, restaurants & real estate | Matombo",
  description: "Practical digital marketing insights for Lagos hospitality and property: winning Hotels Lagos and AirBnB Lagos search, filling restaurant and lounge Lagos tables, and selling real estate Lagos.",
  keywords: "Hotels Lagos, AirBnB Lagos, Restaurant and lounge Lagos, real estate Lagos, Lagos marketing blog",
  jsonLd: jsonLd,
}) %>

<div style="font-family:var(--font-body);color:var(--text-primary);background:var(--bg-page);overflow-x:hidden;min-height:100vh">

  <%- include('partials/nav', { active: 'blog' }) %>

  <!-- HERO -->
  <section style="max-width:1200px;margin:0 auto;padding:clamp(48px,7vw,88px) 24px clamp(28px,4vw,40px)">
    <span style="display:inline-block;font-size:12px;font-weight:600;letter-spacing:0.16em;text-transform:uppercase;color:var(--primary);margin-bottom:18px">Insights</span>
    <h1 style="font-family:var(--font-display);font-weight:700;font-size:clamp(38px,6.5vw,80px);line-height:1.03;letter-spacing:-0.02em;margin:0 0 20px;max-width:18ch">Lagos growth, written down.</h1>
    <p style="font-size:clamp(17px,1.6vw,20px);line-height:1.55;color:var(--text-secondary);max-width:60ch;margin:0">Practical playbooks for hospitality and property marketing in Lagos — straight from the team running the campaigns.</p>
  </section>

  <!-- FEATURED POST -->
  <% if (featuredPost) { %>
  <section style="max-width:1200px;margin:0 auto;padding:0 24px clamp(36px,5vw,48px)">
    <article style="border:1px solid var(--border);border-radius:12px;overflow:hidden;display:flex;flex-wrap:wrap;background:var(--surface);transition:box-shadow 150ms ease,transform 150ms ease" style-hover="transform:translateY(-2px);box-shadow:var(--shadow-card-hover)">
      <a href="blog.dc.html" aria-label="Read: <%= featuredPost.title %>" style="flex:1 1 380px;min-width:0;text-decoration:none;color:inherit"><img src="https://picsum.photos/seed/<%= featuredPost.imageSeed %>/1000/760" alt="A traveller browsing Lagos hotel listings on a phone" loading="lazy" width="1000" height="760" style="display:block;width:100%;height:100%;min-height:280px;object-fit:cover;filter:grayscale(1) contrast(1.04) sepia(0.42) saturate(1.5) hue-rotate(-12deg)"></a>
      <div style="flex:1 1 360px;min-width:0;padding:clamp(28px,4vw,44px);display:flex;flex-direction:column;justify-content:center">
        <div style="display:flex;align-items:center;gap:12px;margin-bottom:16px"><span style="display:inline-flex;align-items:center;padding:3px 10px;border-radius:9999px;background:<%= featuredPost.badge.bg %>;color:<%= featuredPost.badge.color %>;font-size:12px;font-weight:600"><%= featuredPost.badge.label %></span><span style="font-size:13px;color:var(--text-muted)"><%= featuredPost.dateLabel %> · <%= featuredPost.readLabel %></span></div>
        <h2 style="font-family:var(--font-display);font-weight:700;font-size:clamp(24px,3.2vw,36px);line-height:1.1;letter-spacing:-0.01em;margin:0 0 14px"><a href="blog.dc.html" style="text-decoration:none;color:inherit" style-hover="color:var(--primary)" style-focus="outline:2px solid var(--primary);outline-offset:3px;border-radius:2px"><%= featuredPost.title %></a></h2>
        <p style="font-size:16px;line-height:1.6;color:var(--text-secondary);margin:0 0 22px;max-width:54ch"><%= featuredPost.excerpt %></p>
        <div style="display:flex;align-items:center;gap:12px"><span aria-hidden="true" style="display:grid;place-items:center;width:38px;height:38px;border-radius:9999px;background:var(--stone-900);color:var(--stone-50);font-weight:600;font-size:14px"><%= featuredPost.authorInitials %></span><span style="font-size:14px;color:var(--text-secondary)"><%= featuredPost.authorName %></span></div>
      </div>
    </article>
  </section>
  <% } %>

  <!-- POST GRID -->
  <section style="max-width:1200px;margin:0 auto;padding:0 24px clamp(56px,8vw,88px)">
    <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(300px,1fr));gap:24px">
      <% gridPosts.forEach(function (post) { %>
      <x-import component-from-global-scope="EmberStudioDesignSystem_64dbe4.Card" hint-size="100%,420px" style="height:100%;padding:0;overflow:hidden">
        <article style="display:flex;flex-direction:column;height:100%">
          <a href="blog.dc.html" aria-label="Read: <%= post.title %>" style="text-decoration:none"><img src="https://picsum.photos/seed/<%= post.imageSeed %>/800/520" alt="<%= post.title %>" loading="lazy" width="800" height="520" style="display:block;width:100%;height:200px;object-fit:cover;filter:grayscale(1) contrast(1.04) sepia(0.42) saturate(1.5) hue-rotate(-12deg)"></a>
          <div style="padding:22px;display:flex;flex-direction:column;flex:1">
            <div style="display:flex;align-items:center;gap:10px;margin-bottom:14px"><span style="display:inline-flex;align-items:center;padding:3px 10px;border-radius:9999px;background:<%= post.badge.bg %>;color:<%= post.badge.color %>;font-size:12px;font-weight:600"><%= post.badge.label %></span><span style="font-size:13px;color:var(--text-muted)"><%= post.dateLabel %> · <%= post.readLabel %></span></div>
            <h3 style="font-family:var(--font-display);font-weight:700;font-size:22px;line-height:1.15;margin:0 0 10px"><a href="blog.dc.html" style="text-decoration:none;color:inherit" style-hover="color:var(--primary)" style-focus="outline:2px solid var(--primary);outline-offset:3px;border-radius:2px"><%= post.title %></a></h3>
            <p style="font-size:15px;line-height:1.6;color:var(--text-secondary);margin:0 0 20px"><%= post.excerpt %></p>
            <div style="margin-top:auto;display:flex;align-items:center;gap:12px"><span aria-hidden="true" style="display:grid;place-items:center;width:36px;height:36px;border-radius:9999px;background:var(--stone-900);color:var(--stone-50);font-weight:600;font-size:13px"><%= post.authorInitials %></span><span style="font-size:14px;color:var(--text-secondary)"><%= post.authorName %></span></div>
          </div>
        </article>
      </x-import>
      <% }); %>
    </div>
  </section>

  <!-- CTA BAND -->
  <section style="background:var(--stone-900);color:var(--stone-50)">
    <div style="max-width:1200px;margin:0 auto;padding:clamp(56px,8vw,88px) 24px;display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:32px">
      <div style="flex:1 1 420px;min-width:0">
        <h2 style="font-family:var(--font-display);font-weight:700;font-size:clamp(28px,4.5vw,48px);line-height:1.06;letter-spacing:-0.02em;margin:0 0 14px;color:var(--stone-50)">Rather we just did it for you?</h2>
        <p style="font-size:18px;line-height:1.55;color:var(--stone-300);margin:0;max-width:52ch">Book a free strategy call and put these playbooks to work for your brand.</p>
      </div>
      <a href="contact.dc.html" style="display:inline-flex;align-items:center;gap:10px;height:54px;padding:0 30px;border-radius:8px;background:var(--primary);color:#fff;font-weight:600;font-size:18px;text-decoration:none;border:1px solid var(--primary);transition:background 150ms ease,box-shadow 150ms ease" style-hover="background:var(--primary-hover);box-shadow:var(--shadow-button-glow)" style-focus="outline:2px solid #fff;outline-offset:3px">Book a free strategy call <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 5l7 7-7 7"></path></svg></a>
    </div>
  </section>

  <%- include('partials/footer') %>

</div>
</x-dc>
</body>
</html>
