<%
const featuredPost = posts.find(function (p) { return p.featured; });
const gridPosts = posts.filter(function (p) { return !p.featured; });
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Blog",
  name: "Matombo Agency Blog",
  publisher: { "@type": "Organization", name: "Matombo Agency" },
  blogPost: posts.map(function (p) {
    return {
      "@type": "BlogPosting",
      headline: p.title,
      datePublished: p.publishedAt.toISOString().slice(0, 10),
      author: { "@type": "Person", name: p.authorName },
    };
  }),
};
%>
<!DOCTYPE html>
<html lang="en">
<head>
<%- include('partials/head', {
  title: "Blog — Lagos marketing insights for hotels, restaurants & real estate | Matombo",
  description: "Practical digital marketing insights for Lagos hospitality and property: winning Hotels Lagos and AirBnB Lagos search, filling restaurant and lounge Lagos tables, and selling real estate Lagos.",
  keywords: "Hotels Lagos, AirBnB Lagos, Restaurant and lounge Lagos, real estate Lagos, Lagos marketing blog",
  jsonLd: jsonLd,
}) %>
</head>
<body>

<%- include('partials/nav', { active: 'blog' }) %>

<!-- HERO -->
<section class="container section--hero">
  <span class="hero-eyebrow">Insights</span>
  <h1 class="hero-title" style="max-width:18ch">Lagos growth, written down.</h1>
  <p class="hero-subtitle">Practical playbooks for hospitality and property marketing in Lagos — straight from the team running the campaigns.</p>
</section>

<!-- FEATURED POST -->
<% if (featuredPost) { %>
<section class="container" style="padding:0 0 clamp(36px,5vw,48px)">
  <article class="card card--flush" style="flex-direction:row;flex-wrap:wrap">
    <a href="/blog" aria-label="Read: <%= featuredPost.title %>" style="flex:1 1 380px;min-width:0;text-decoration:none;color:inherit"><img src="https://picsum.photos/seed/<%= featuredPost.imageSeed %>/1000/760" alt="A traveller browsing Lagos hotel listings on a phone" loading="lazy" width="1000" height="760" style="height:100%;min-height:280px;object-fit:cover;filter:grayscale(1) contrast(1.04) sepia(0.42) saturate(1.5) hue-rotate(-12deg)"></a>
    <div style="flex:1 1 360px;min-width:0;padding:clamp(28px,4vw,44px);display:flex;flex-direction:column;justify-content:center">
      <div style="display:flex;align-items:center;gap:12px;margin-bottom:16px"><span class="badge" style="background:<%= featuredPost.badge.bg %>;color:<%= featuredPost.badge.color %>"><%= featuredPost.badge.label %></span><span style="font-size:13px;color:var(--text-muted)"><%= featuredPost.dateLabel %> &middot; <%= featuredPost.readLabel %></span></div>
      <h2 style="font-size:clamp(24px,3.2vw,36px);line-height:1.1;letter-spacing:-0.01em;margin:0 0 14px"><a href="/blog" style="text-decoration:none;color:inherit"><%= featuredPost.title %></a></h2>
      <p style="font-size:16px;line-height:1.6;color:var(--text-secondary);margin:0 0 22px;max-width:54ch"><%= featuredPost.excerpt %></p>
      <div style="display:flex;align-items:center;gap:12px"><span class="avatar" aria-hidden="true"><%= featuredPost.authorInitials %></span><span style="font-size:14px;color:var(--text-secondary)"><%= featuredPost.authorName %></span></div>
    </div>
  </article>
</section>
<% } %>

<!-- POST GRID -->
<section class="container" style="padding:0 0 clamp(56px,8vw,88px)">
  <div class="cards-grid cards-grid--wide">
    <% gridPosts.forEach(function (post) { %>
    <article class="card card--flush">
      <a href="/blog" aria-label="Read: <%= post.title %>"><img class="card-image" src="https://picsum.photos/seed/<%= post.imageSeed %>/800/520" alt="<%= post.title %>" loading="lazy" width="800" height="520"></a>
      <div class="card-body">
        <div style="display:flex;align-items:center;gap:10px;margin-bottom:14px"><span class="badge" style="background:<%= post.badge.bg %>;color:<%= post.badge.color %>"><%= post.badge.label %></span><span style="font-size:13px;color:var(--text-muted)"><%= post.dateLabel %> &middot; <%= post.readLabel %></span></div>
        <h3 style="font-size:22px;line-height:1.15;margin:0 0 10px"><a href="/blog" style="text-decoration:none;color:inherit"><%= post.title %></a></h3>
        <p style="font-size:15px;line-height:1.6;color:var(--text-secondary);margin:0 0 20px"><%= post.excerpt %></p>
        <div style="margin-top:auto;display:flex;align-items:center;gap:12px"><span class="avatar avatar--sm" aria-hidden="true"><%= post.authorInitials %></span><span style="font-size:14px;color:var(--text-secondary)"><%= post.authorName %></span></div>
      </div>
    </article>
    <% }); %>
  </div>
</section>

<!-- CTA BAND -->
<section class="section--dark">
  <div class="container section" style="display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:32px">
    <div style="flex:1 1 420px;min-width:0">
      <h2 class="section-title" style="margin-bottom:14px;color:var(--stone-50)">Rather we just did it for you?</h2>
      <p style="font-size:18px;line-height:1.55;color:var(--stone-300);margin:0;max-width:52ch">Book a free strategy call and put these playbooks to work for your brand.</p>
    </div>
    <a href="/contact" class="btn btn-primary" style="height:54px;font-size:18px">Book a free strategy call <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 5l7 7-7 7"></path></svg></a>
  </div>
</section>

<%- include('partials/footer') %>

</body>
</html>
